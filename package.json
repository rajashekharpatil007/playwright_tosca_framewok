{
  "name": "tosca-cucumber-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Cucumber BDD and Playwright conversion of the Tosca vehicle insurance sample project",
  "scripts": {
    "convert:tosca": "node scripts/convert-tosca.js",
    "test": "npm run clean:reports && cucumber-js",
    "test:headed": "cross-env HEADLESS=false npm test",
    "test:headless": "cross-env HEADLESS=true npm test",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "open:allure": "allure open allure-report",
    "clean:reports": "node scripts/clean-reports.js",
    "validate:conversion": "node scripts/validate-conversion.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/node": "^22.13.10",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.3.2",
    "cross-env": "^7.0.3",
    "playwright": "^1.51.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  }
}
